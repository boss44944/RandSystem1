{
  "openapi": "3.0.3",
  "info": {
    "title": "RandSystem1 API",
    "version": "0.5.0",
    "description": "Iterations 001-005: random baselines, statistical evaluation, complementarity and guarded frozen-weight fusion."
  },
  "paths": {
    "/api/health": {
      "get": {
        "responses": {
          "200": {
            "description": "Service health"
          }
        }
      }
    },
    "/api/models": {
      "get": {
        "responses": {
          "200": {
            "description": "Available models"
          }
        }
      }
    },
    "/api/models/predict": {
      "post": {
        "parameters": [
          {
            "name": "modelId",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "default": "mock-uniform"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DecisionRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Simulated prediction",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DecisionPrediction"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request"
          },
          "404": {
            "description": "Model not found"
          },
          "502": {
            "description": "Model output failed validation"
          }
        }
      }
    },
    "/api/random/generate": {
      "post": {
        "summary": "Generate reproducible simulated random baselines and independent ensemble members",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BaselineRunRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Simulation with per-member seeds, probabilities and sampled choices",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BaselineRunResult"
                }
              }
            }
          },
          "400": {
            "description": "Invalid baseline, alpha, options, training labels or batch size"
          }
        }
      }
    },
    "/api/evaluation/run": {
      "post": {
        "summary": "Classification and probability metrics, calibration, optional aligned skill scores.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EvaluationRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Classification and probability metrics, calibration, optional aligned skill scores. See docs/API.md for response semantics."
          },
          "400": {
            "description": "Invalid request, unsafe inference assumptions, dataset alignment or nonfinite values."
          }
        }
      }
    },
    "/api/evaluation/monte-carlo": {
      "post": {
        "summary": "Seeded random null distribution for fixed labeled examples; optional empirical upper-tail.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MonteCarloRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Seeded random null distribution for fixed labeled examples; optional empirical upper-tail. See docs/API.md for response semantics."
          },
          "400": {
            "description": "Invalid request, unsafe inference assumptions, dataset alignment or nonfinite values."
          }
        }
      }
    },
    "/api/evaluation/paired": {
      "post": {
        "summary": "Paired loss improvement and bootstrap interval; IID permutation or timeseries block bootstrap.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PairedComparisonRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Paired loss improvement and bootstrap interval; IID permutation or timeseries block bootstrap. See docs/API.md for response semantics."
          },
          "400": {
            "description": "Invalid request, unsafe inference assumptions, dataset alignment or nonfinite values."
          }
        }
      }
    },
    "/api/evaluation/binomial": {
      "post": {
        "summary": "Exact one-sided binomial tail only when IID assumptions explicitly confirmed.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ExactBinomialRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Exact one-sided binomial tail only when IID assumptions explicitly confirmed. See docs/API.md for response semantics."
          },
          "400": {
            "description": "Invalid request, unsafe inference assumptions, dataset alignment or nonfinite values."
          }
        }
      }
    },
    "/api/evaluation/complementarity": {
      "post": {
        "summary": "Alignment-safe multi-model disagreement, error association, joint correctness and Oracle upper bound",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ComplementarityRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Complementarity report",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ComplementarityReport"
                }
              }
            }
          },
          "400": {
            "description": "Invalid/misaligned models or labels"
          }
        }
      }
    },
    "/api/fusion/predict": {
      "post": {
        "summary": "Validated equal/static/performance/dynamic probability fusion with explicit failures and default ABSTAIN",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/FusionRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FusionResult"
                }
              }
            }
          },
          "400": {
            "description": "Invalid configuration, input or alignment"
          }
        }
      }
    },
    "/api/fusion/holdout": {
      "post": {
        "summary": "Frozen-validation-weight holdout accuracy/Brier comparison to models and theoretical uniform baseline",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/FusionHoldoutRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FusionHoldoutReport"
                }
              }
            }
          },
          "400": {
            "description": "Invalid configuration, input or alignment"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "DecisionRequest": {
        "type": "object",
        "required": [
          "requestId",
          "taskType",
          "options"
        ],
        "properties": {
          "requestId": {
            "type": "string"
          },
          "taskType": {
            "type": "string"
          },
          "options": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "context": {
            "type": "object",
            "additionalProperties": true
          }
        }
      },
      "DecisionPrediction": {
        "type": "object",
        "required": [
          "requestId",
          "taskType",
          "modelId",
          "modelVersion",
          "probabilities",
          "predictedOption",
          "latencyMs",
          "predictedAt",
          "isSimulation"
        ],
        "properties": {
          "requestId": {
            "type": "string"
          },
          "taskType": {
            "type": "string"
          },
          "modelId": {
            "type": "string"
          },
          "modelVersion": {
            "type": "string"
          },
          "probabilities": {
            "type": "object",
            "additionalProperties": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          },
          "predictedOption": {
            "type": "string"
          },
          "latencyMs": {
            "type": "number",
            "minimum": 0
          },
          "predictedAt": {
            "type": "string",
            "format": "date-time"
          },
          "isSimulation": {
            "type": "boolean"
          }
        }
      },
      "BaselineRunRequest": {
        "type": "object",
        "required": [
          "baseline",
          "options"
        ],
        "properties": {
          "baseline": {
            "type": "string",
            "enum": [
              "uniform",
              "dirichlet",
              "majority",
              "prior"
            ]
          },
          "options": {
            "type": "array",
            "minItems": 1,
            "maxItems": 256,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "seed": {
            "type": "integer",
            "format": "int32",
            "default": 42
          },
          "count": {
            "type": "integer",
            "minimum": 1,
            "maximum": 200,
            "default": 1
          },
          "samplesPerModel": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2000,
            "default": 1
          },
          "alpha": {
            "type": "number",
            "exclusiveMinimum": 0,
            "default": 1.0
          },
          "trainingLabels": {
            "type": "array",
            "maxItems": 100000,
            "items": {
              "type": "string"
            }
          }
        }
      },
      "BaselineRunResult": {
        "type": "object",
        "description": "All probabilities are constructed simulations and not observed accuracy or calibrated confidence.",
        "properties": {
          "baseline": {
            "type": "string"
          },
          "engineVersion": {
            "type": "string"
          },
          "seed": {
            "type": "integer"
          },
          "count": {
            "type": "integer"
          },
          "samplesPerModel": {
            "type": "integer"
          },
          "alpha": {
            "type": "number",
            "nullable": true
          },
          "trainingLabelCount": {
            "type": "integer",
            "nullable": true
          },
          "isSimulation": {
            "type": "boolean",
            "enum": [
              true
            ]
          },
          "probabilityMeaning": {
            "type": "string"
          },
          "members": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "modelIndex": {
                  "type": "integer"
                },
                "modelId": {
                  "type": "string"
                },
                "seedHex": {
                  "type": "string"
                },
                "draws": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "sampleIndex": {
                        "type": "integer"
                      },
                      "probabilities": {
                        "type": "object",
                        "additionalProperties": {
                          "type": "number"
                        }
                      },
                      "sampledOption": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "ScoredObservation": {
        "type": "object",
        "required": [
          "observationId",
          "actual",
          "predicted",
          "probabilities"
        ],
        "properties": {
          "observationId": {
            "type": "string",
            "minLength": 1
          },
          "actual": {
            "type": "string"
          },
          "predicted": {
            "type": "string"
          },
          "probabilities": {
            "type": "object",
            "additionalProperties": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        }
      },
      "EvaluationRequest": {
        "type": "object",
        "required": [
          "options",
          "observations"
        ],
        "properties": {
          "options": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "maxItems": 256,
            "uniqueItems": true
          },
          "observations": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ScoredObservation"
            },
            "minItems": 1,
            "maxItems": 100000
          },
          "calibrationBins": {
            "type": "integer",
            "minimum": 2,
            "maximum": 100,
            "default": 10
          },
          "baselineObservations": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ScoredObservation"
            },
            "description": "Optional aligned held-out baseline observations for skill scores"
          }
        }
      },
      "MonteCarloRequest": {
        "type": "object",
        "required": [
          "options",
          "testLabels"
        ],
        "properties": {
          "options": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "maxItems": 256
          },
          "testLabels": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "maxItems": 2000
          },
          "baseline": {
            "type": "string",
            "enum": [
              "uniform",
              "dirichlet",
              "majority",
              "prior"
            ],
            "default": "uniform"
          },
          "iterations": {
            "type": "integer",
            "minimum": 20,
            "maximum": 10000,
            "default": 1000
          },
          "seed": {
            "type": "integer",
            "format": "int32",
            "default": 42
          },
          "alpha": {
            "type": "number",
            "exclusiveMinimum": 0,
            "default": 1
          },
          "trainingLabels": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Only for fitted majority/prior, must come exclusively from training split"
          },
          "observedPredictions": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Optional aligned, already evaluated model predictions"
          }
        }
      },
      "PairedComparisonRequest": {
        "type": "object",
        "required": [
          "options",
          "model",
          "baseline",
          "sampleStructure"
        ],
        "properties": {
          "options": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "model": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ScoredObservation"
            }
          },
          "baseline": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ScoredObservation"
            }
          },
          "loss": {
            "type": "string",
            "enum": [
              "brier",
              "logloss"
            ],
            "default": "brier"
          },
          "sampleStructure": {
            "type": "string",
            "enum": [
              "iid",
              "timeseries"
            ],
            "description": "Explicit assumption required; no implicit IID inference."
          },
          "blockLength": {
            "type": "integer",
            "default": 1,
            "description": "For timeseries choose length >=2 and <= sample count."
          },
          "replications": {
            "type": "integer",
            "minimum": 200,
            "maximum": 20000,
            "default": 2000
          },
          "seed": {
            "type": "integer",
            "format": "int32",
            "default": 42
          },
          "confidenceLevel": {
            "type": "number",
            "exclusiveMinimum": 0,
            "exclusiveMaximum": 1,
            "default": 0.95
          },
          "comparisons": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10000,
            "default": 1
          },
          "chronologicalOrderConfirmed": {
            "type": "boolean",
            "default": false,
            "description": "Must be true for timeseries. Labels must not leak future data."
          }
        }
      },
      "ExactBinomialRequest": {
        "type": "object",
        "required": [
          "successes",
          "trials",
          "fixedNullSuccessProbability",
          "independentTrialsConfirmed"
        ],
        "properties": {
          "successes": {
            "type": "integer",
            "minimum": 0
          },
          "trials": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100000
          },
          "fixedNullSuccessProbability": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "independentTrialsConfirmed": {
            "type": "boolean",
            "description": "Must explicitly confirm IID Bernoulli null with fixed known probability."
          }
        }
      },
      "ModelChoice": {
        "type": "object",
        "required": [
          "observationId",
          "predictedOption"
        ],
        "properties": {
          "observationId": {
            "type": "string"
          },
          "predictedOption": {
            "type": "string"
          }
        }
      },
      "NamedModelChoices": {
        "type": "object",
        "required": [
          "modelId",
          "predictions"
        ],
        "properties": {
          "modelId": {
            "type": "string"
          },
          "predictions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ModelChoice"
            },
            "minItems": 1,
            "maxItems": 20000
          }
        }
      },
      "ObservedTruth": {
        "type": "object",
        "required": [
          "observationId",
          "actual"
        ],
        "properties": {
          "observationId": {
            "type": "string"
          },
          "actual": {
            "type": "string"
          }
        }
      },
      "ComplementarityRequest": {
        "type": "object",
        "required": [
          "options",
          "models"
        ],
        "properties": {
          "options": {
            "type": "array",
            "minItems": 1,
            "maxItems": 256,
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "models": {
            "type": "array",
            "minItems": 2,
            "maxItems": 20,
            "items": {
              "$ref": "#/components/schemas/NamedModelChoices"
            }
          },
          "groundTruth": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ObservedTruth"
            },
            "description": "Optional; exact observation IDs and order are required."
          }
        }
      },
      "PairComplementarity": {
        "type": "object",
        "properties": {
          "modelA": {
            "type": "string"
          },
          "modelB": {
            "type": "string"
          },
          "total": {
            "type": "integer"
          },
          "agreementCount": {
            "type": "integer"
          },
          "disagreementCount": {
            "type": "integer"
          },
          "disagreementRate": {
            "type": "number"
          },
          "bothCorrect": {
            "type": "integer",
            "nullable": true
          },
          "bothWrong": {
            "type": "integer",
            "nullable": true
          },
          "onlyACorrect": {
            "type": "integer",
            "nullable": true
          },
          "onlyBCorrect": {
            "type": "integer",
            "nullable": true
          },
          "modelAAccuracy": {
            "type": "number",
            "nullable": true
          },
          "modelBAccuracy": {
            "type": "number",
            "nullable": true
          },
          "jointCorrectCoverage": {
            "type": "number",
            "nullable": true
          },
          "errorPhiCorrelation": {
            "type": "number",
            "nullable": true
          },
          "oracleUpperBound": {
            "type": "number",
            "nullable": true
          },
          "oracleGainOverBestSingle": {
            "type": "number",
            "nullable": true
          }
        }
      },
      "ComplementarityReport": {
        "type": "object",
        "properties": {
          "sampleCount": {
            "type": "integer"
          },
          "modelCount": {
            "type": "integer"
          },
          "hasGroundTruth": {
            "type": "boolean"
          },
          "models": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "modelId": {
                  "type": "string"
                },
                "accuracy": {
                  "type": "number",
                  "nullable": true
                },
                "predictionCounts": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "integer"
                  }
                }
              }
            }
          },
          "pairs": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PairComplementarity"
            }
          },
          "interpretation": {
            "type": "string"
          },
          "atLeastOneCorrectCoverage": {
            "type": "number",
            "nullable": true
          },
          "oracleUpperBound": {
            "type": "number",
            "nullable": true
          },
          "oracleGainOverBestSingle": {
            "type": "number",
            "nullable": true
          }
        },
        "description": "Oracle is a hindsight ceiling, not a deployable model fusion result. Accuracy/oracle null without truth."
      },
      "FusionModelPrediction": {
        "type": "object",
        "required": [
          "modelId",
          "status"
        ],
        "properties": {
          "modelId": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "success",
              "missing",
              "failed",
              "timeout",
              "invalid",
              "cancelled"
            ]
          },
          "probabilities": {
            "type": "object",
            "additionalProperties": {
              "type": "number",
              "format": "double"
            },
            "description": "Finite, nonnegative per-option probabilities summing to one."
          },
          "isSimulation": {
            "type": "boolean"
          }
        }
      },
      "FusionValidationEvidence": {
        "type": "object",
        "required": [
          "modelId",
          "taskType",
          "split",
          "sampleCount",
          "brierLoss",
          "baselineBrierLoss",
          "lowerSkillBound",
          "validationEndedAt"
        ],
        "properties": {
          "modelId": {
            "type": "string"
          },
          "taskType": {
            "type": "string"
          },
          "segment": {
            "type": "string",
            "nullable": true
          },
          "split": {
            "type": "string",
            "enum": [
              "validation"
            ]
          },
          "sampleCount": {
            "type": "integer"
          },
          "brierLoss": {
            "type": "number",
            "format": "double"
          },
          "baselineBrierLoss": {
            "type": "number",
            "format": "double"
          },
          "lowerSkillBound": {
            "type": "number",
            "format": "double"
          },
          "validationEndedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "FusionStrategyEvidence": {
        "type": "object",
        "required": [
          "strategy",
          "taskType",
          "split",
          "sampleCount",
          "lowerBrierSkillBound",
          "validationEndedAt",
          "modelIds",
          "frozenWeights"
        ],
        "properties": {
          "strategy": {
            "type": "string"
          },
          "taskType": {
            "type": "string"
          },
          "segment": {
            "type": "string",
            "nullable": true
          },
          "split": {
            "type": "string",
            "enum": [
              "validation"
            ]
          },
          "sampleCount": {
            "type": "integer"
          },
          "lowerBrierSkillBound": {
            "type": "number",
            "format": "double"
          },
          "validationEndedAt": {
            "type": "string",
            "format": "date-time"
          },
          "modelIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "frozenWeights": {
            "type": "object",
            "additionalProperties": {
              "type": "number",
              "format": "double"
            },
            "description": "Finite, nonnegative per-option probabilities summing to one."
          }
        }
      },
